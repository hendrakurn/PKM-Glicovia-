    {"id":"arlab","type":"text","x":740,"y":570,"width":500,"height":60,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2260,"version":1,"versionNonce":22600,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"→ ke CE  (kuning)  |  → ke RE Ag/AgCl (hijau muda, acuan 0V)\n→ ke WE  (hijau)   |  Potensiostat jaga WE = +0.6V vs RE\nArus di WE ∝ [H2O2] ∝ [Glukosa] → TIA → ADC → ESP32","fontSize":12,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":11,"containerId":null,"originalText":"→ ke CE  (kuning)  |  → ke RE Ag/AgCl (hijau muda, acuan 0V)\n→ ke WE  (hijau)   |  Potensiostat jaga WE = +0.6V vs RE\nArus di WE ∝ [H2O2] ∝ [Glukosa] → TIA → ADC → ESP32","lineHeight":1.4},
    {"id":"qr","type":"rectangle","x":720,"y":645,"width":620,"height":215,"angle":0,"strokeColor":"#374151","backgroundColor":"#f9fafb","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":3010,"version":1,"versionNonce":30100,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"qt","type":"text","x":730,"y":655,"width":600,"height":22,"angle":0,"strokeColor":"#111827","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3020,"version":1,"versionNonce":30200,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"KEBUTUHAN GOx PER PRODUKSI","fontSize":14,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"KEBUTUHAN GOx PER PRODUKSI","lineHeight":1.25},
    {"id":"qb","type":"text","x":730,"y":681,"width":600,"height":170,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3030,"version":1,"versionNonce":30300,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Per 1 elektroda WE:\n  Volume tetesan    : 3-5 µL\n  Konsentrasi GOx   : 10 mg/mL\n  GOx per elektroda : 0.03-0.05 mg  =  30-50 µg\n\nPer 1 batch cartridge (20 pcs):\n  Total GOx         : 20 x 0.05 mg  =  1 mg GOx\n  Harga GOx         : ~$2-5 USD / mg (Sigma-Aldrich)\n  → Cukup ekonomis untuk banyak cartridge","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"Per 1 elektroda WE:\n  Volume tetesan    : 3-5 µL\n  Konsentrasi GOx   : 10 mg/mL\n  GOx per elektroda : 0.03-0.05 mg  =  30-50 µg\n\nPer 1 batch cartridge (20 pcs):\n  Total GOx         : 20 x 0.05 mg  =  1 mg GOx\n  Harga GOx         : ~$2-5 USD / mg (Sigma-Aldrich)\n  → Cukup ekonomis untuk banyak cartridge","lineHeight":1.4},
    {"id":"rxnt","type":"text","x":720,"y":878,"width":600,"height":22,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4010,"version":1,"versionNonce":40100,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"REAKSI KIMIA BERTAHAP (Alur Sinyal Sensor)","fontSize":14,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"REAKSI KIMIA BERTAHAP (Alur Sinyal Sensor)","lineHeight":1.25},
    {"id":"rxnr","type":"rectangle","x":720,"y":908,"width":620,"height":160,"angle":0,"strokeColor":"#1d4ed8","backgroundColor":"#eff6ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":4020,"version":1,"versionNonce":40200,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"rxnb","type":"text","x":730,"y":918,"width":600,"height":145,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4030,"version":1,"versionNonce":40300,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Reaksi 1 (di lapisan GOx-BSA):\n  Glukosa + O2  -[GOx]->  Glukonolakton + H2O2\n\nReaksi 2 (di permukaan WE karbon, +0.6V):\n  H2O2  ->  O2 + 2H+ + 2e-  (oksidasi elektrode)\n\nHasil akhir:\n  Arus listrik ∝ [H2O2] ∝ [Glukosa saliva]\n  ADC baca tegangan → kadar glukosa (mg/dL)","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"Reaksi 1 (di lapisan GOx-BSA):\n  Glukosa + O2  -[GOx]->  Glukonolakton + H2O2\n\nReaksi 2 (di permukaan WE karbon, +0.6V):\n  H2O2  ->  O2 + 2H+ + 2e-  (oksidasi elektrode)\n\nHasil akhir:\n  Arus listrik ∝ [H2O2] ∝ [Glukosa saliva]\n  ADC baca tegangan → kadar glukosa (mg/dL)","lineHeight":1.4}
