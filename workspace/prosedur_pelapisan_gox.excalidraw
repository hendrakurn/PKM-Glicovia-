    {"id":"e5","type":"text","x":45,"y":116,"width":620,"height":150,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":5,"version":1,"versionNonce":5,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Campurkan dalam wadah bersih:\n  GOx         :  10 mg\n  BSA         :  10 mg\n  PBS pH 7.4  :  1 mL\n\n→ Aduk perlahan hingga homogen\n→ Hasil = \"GOx-BSA solution\" (10 mg/mL)","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"Campurkan dalam wadah bersih:\n  GOx         :  10 mg\n  BSA         :  10 mg\n  PBS pH 7.4  :  1 mL\n\n→ Aduk perlahan hingga homogen\n→ Hasil = \"GOx-BSA solution\" (10 mg/mL)","lineHeight":1.4},
