    {"id":"e10","type":"text","x":45,"y":625,"width":620,"height":22,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":100,"version":1,"versionNonce":1000,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"LANGKAH 3: Tambahkan Glutaraldehyde (Crosslinker, 30 menit)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"LANGKAH 3: Tambahkan Glutaraldehyde (Crosslinker, 30 menit)","lineHeight":1.25},
    {"id":"e11","type":"text","x":45,"y":651,"width":620,"height":170,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":110,"version":1,"versionNonce":1100,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"1. Ambil 2-3 µL Glutaraldehyde 2.5%\n2. Teteskan di atas lapisan GOx-BSA\n3. Biarkan 30 menit suhu ruang\n\nReaksi crosslinking:\n  GOx .. BSA .. GOx   (bebas, sebelum GA)\n  GOx─BSA─GOx─BSA   (terkunci, setelah GA)\n\n→ Protein saling diikat = tidak lepas dari elektroda","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"1. Ambil 2-3 µL Glutaraldehyde 2.5%\n2. Teteskan di atas lapisan GOx-BSA\n3. Biarkan 30 menit suhu ruang\n\nReaksi crosslinking:\n  GOx .. BSA .. GOx   (bebas, sebelum GA)\n  GOx─BSA─GOx─BSA   (terkunci, setelah GA)\n\n→ Protein saling diikat = tidak lepas dari elektroda","lineHeight":1.4},
    {"id":"a3","type":"arrow","x":355,"y":833,"width":0,"height":47,"angle":0,"strokeColor":"#15803d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":30,"version":1,"versionNonce":30,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"points":[[0,0],[0,47]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},
