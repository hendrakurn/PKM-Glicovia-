    {"id":"e13","type":"text","x":45,"y":895,"width":620,"height":22,"angle":0,"strokeColor":"#0c4a6e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":130,"version":1,"versionNonce":1300,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"LANGKAH 4: Bilas dengan PBS (3x ulang)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"LANGKAH 4: Bilas dengan PBS (3x ulang)","lineHeight":1.25},
    {"id":"e14","type":"text","x":45,"y":921,"width":620,"height":120,"angle":0,"strokeColor":"#0c4a6e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140,"version":1,"versionNonce":1400,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"1. Teteskan 10 µL PBS bersih ke atas elektroda\n2. Miringkan cartridge → PBS mengalir keluar\n3. Ulangi 3x\n\n→ Tujuan: membuang sisa glutaraldehyde bebas\n→ GA bebas bersifat toksik dan mengganggu sensor","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"1. Teteskan 10 µL PBS bersih ke atas elektroda\n2. Miringkan cartridge → PBS mengalir keluar\n3. Ulangi 3x\n\n→ Tujuan: membuang sisa glutaraldehyde bebas\n→ GA bebas bersifat toksik dan mengganggu sensor","lineHeight":1.4},
