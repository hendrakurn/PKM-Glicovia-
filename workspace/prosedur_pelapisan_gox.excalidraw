    {"id":"e8","type":"text","x":45,"y":366,"width":420,"height":185,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":8,"version":1,"versionNonce":8,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"1. Ambil 3-5 µL larutan GOx-BSA\n   menggunakan micropipette\n2. Teteskan TEPAT di atas permukaan\n   WE (elektroda karbon)\n3. Biarkan meresap 10 menit\n   di suhu ruang","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"1. Ambil 3-5 µL larutan GOx-BSA\n   menggunakan micropipette\n2. Teteskan TEPAT di atas permukaan\n   WE (elektroda karbon)\n3. Biarkan meresap 10 menit\n   di suhu ruang","lineHeight":1.4},
