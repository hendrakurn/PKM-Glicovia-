    {"id":"e16","type":"text","x":45,"y":1115,"width":620,"height":22,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":160,"version":1,"versionNonce":1600,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"LANGKAH 5: Lapisan Nafion 0.5% (opsional, sangat disarankan)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"LANGKAH 5: Lapisan Nafion 0.5% (opsional, sangat disarankan)","lineHeight":1.25},
    {"id":"e17","type":"text","x":45,"y":1141,"width":620,"height":155,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":170,"version":1,"versionNonce":1700,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"1. Teteskan 2 µL Nafion 0.5%\n2. Biarkan kering sendiri 10 menit suhu ruang\n\nFungsi Nafion (filter selektif):\n  [Saliva] → [Nafion] → [GOx] → [Elektroda]\n\n  Glukosa        → MASUK  (diizinkan)\n  Asam askorbat  → TOLAK  (diblokir)\n  Urea, UA, dll  → TOLAK  (diblokir)","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"1. Teteskan 2 µL Nafion 0.5%\n2. Biarkan kering sendiri 10 menit suhu ruang\n\nFungsi Nafion (filter selektif):\n  [Saliva] → [Nafion] → [GOx] → [Elektroda]\n\n  Glukosa        → MASUK  (diizinkan)\n  Asam askorbat  → TOLAK  (diblokir)\n  Urea, UA, dll  → TOLAK  (diblokir)","lineHeight":1.4},
    {"id":"a5","type":"arrow","x":355,"y":1308,"width":0,"height":47,"angle":0,"strokeColor":"#9333ea","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":50,"version":1,"versionNonce":50,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"points":[[0,0],[0,47]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},
