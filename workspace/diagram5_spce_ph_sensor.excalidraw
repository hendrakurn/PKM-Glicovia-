    {"id":"ph_s5_ht","type":"text","x":518,"y":322","width":512,"height":18,"angle":0,"strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":552,"version":1,"versionNonce":552,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"5. KALIBRASI & KOREKSI SUHU","fontSize":12,"fontFamily":2,"textAlign":"center","verticalAlign":"top","baseline":10,"containerId":null,"originalText":"5. KALIBRASI & KOREKSI SUHU","lineHeight":1.25},

    {"id":"ph_cal_left","type":"rectangle","x":528,"y":351","width":230,"height":166,"angle":0,"strokeColor":"#15803d","backgroundColor":"#bbf7d0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":553,"version":1,"versionNonce":553,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"ph_cal_left_t","type":"text","x":536,"y":358","width":214,"height":152,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":554,"version":1,"versionNonce":554,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Prosedur Kalibrasi 2-Titik:\n\n① Celupkan elektroda ke\n   buffer pH 6,8 → catat V₁\n\n② Celupkan ke buffer pH 7,4\n   → catat V₂\n\nSlope = (V₂ − V₁) / (7,4 − 6,8)\n       = (V₂ − V₁) / 0,6\n\nTarget: slope ≈ −59 mV/pH\n(Nernst, 25°C)\n\npH_sampel = (V_sampel − V₁)/slope + 6,8","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Prosedur Kalibrasi 2-Titik:\n\n① Celupkan elektroda ke\n   buffer pH 6,8 → catat V₁\n\n② Celupkan ke buffer pH 7,4\n   → catat V₂\n\nSlope = (V₂ − V₁) / (7,4 − 6,8)\n       = (V₂ − V₁) / 0,6\n\nTarget: slope ≈ −59 mV/pH\n(Nernst, 25°C)\n\npH_sampel = (V_sampel − V₁)/slope + 6,8","lineHeight":1.5},

    {"id":"ph_cal_right","type":"rectangle","x":768,"y":351","width":252,"height":166,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":555,"version":1,"versionNonce":555,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"ph_cal_right_t","type":"text","x":776,"y":358","width":236,"height":152,"angle":0,"strokeColor":"#713f12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":556,"version":1,"versionNonce":556,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Koreksi Suhu (Nernst):\n\nSlope aktual:\n  S(T) = −(RT/F) × ln(10)\n       = −0,1984 × T  mV/pH\n  (T dalam Kelvin)\n\n25°C → S = −59,16 mV/pH\n30°C → S = −60,15 mV/pH\n37°C → S = −61,54 mV/pH\n\nESP32 baca sensor suhu (NTC)\n→ hitung S(T) → koreksi pH\n\nTarget validasi: R² ≥ 0,99","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Koreksi Suhu (Nernst):\n\nSlope aktual:\n  S(T) = −(RT/F) × ln(10)\n       = −0,1984 × T  mV/pH\n  (T dalam Kelvin)\n\n25°C → S = −59,16 mV/pH\n30°C → S = −60,15 mV/pH\n37°C → S = −61,54 mV/pH\n\nESP32 baca sensor suhu (NTC)\n→ hitung S(T) → koreksi pH\n\nTarget validasi: R² ≥ 0,99","lineHeight":1.5},

    {"id":"ph_footer","type":"rectangle","x":10,"y":538","width":1020,"height":44,"angle":0,"strokeColor":"#374151","backgroundColor":"#f9fafb","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":557,"version":1,"versionNonce":557,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"ph_footer_t","type":"text","x":18,"y":548","width":1004,"height":28,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":558,"version":1,"versionNonce":558,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Keunggulan IrOx vs PANI (Polyaniline): IrOx lebih stabil di biofluida kompleks (saliva mengandung protein, enzim, mukus), tidak terdegradasi\noleh oksidasi udara, dan memiliki rentang kerja pH yang lebih luas (pH 2–12).  Referensi: Duan et al. (2024), Paimard et al. (2023)","fontSize":11,"fontFamily":1,"textAlign":"center","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Keunggulan IrOx vs PANI (Polyaniline): IrOx lebih stabil di biofluida kompleks (saliva mengandung protein, enzim, mukus), tidak terdegradasi\noleh oksidasi udara, dan memiliki rentang kerja pH yang lebih luas (pH 2–12).  Referensi: Duan et al. (2024), Paimard et al. (2023)","lineHeight":1.4}
  ]
}
