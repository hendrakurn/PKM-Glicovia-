    {"id":"ph_ocp_note_t","type":"text","x":28,"y":489","width":464,"height":22,"angle":0,"strokeColor":"#713f12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":549,"version":1,"versionNonce":549,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"OCP = PASIF: Reader hanya membaca tegangan, tidak mengalirkan arus. Elektroda IrOx tidak terdegradasi.","fontSize":11,"fontFamily":1,"textAlign":"center","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"OCP = PASIF: Reader hanya membaca tegangan, tidak mengalirkan arus. Elektroda IrOx tidak terdegradasi.","lineHeight":1.25},

