    {"id":"p_ocp_diagram_t","type":"text","x":342,"y":162,"width":274,"height":146,"angle":0,"strokeColor":"#581c87","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":725,"version":1,"versionNonce":725,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Diagram Pengukuran OCP:\n\n[WE-2 IrOx] ──────┐\n                       ├─ V_OCP ──► ADS1115\n[RE Ag/AgCl]  ──────┘\n\nKarateristik OCP:\n• TIDAK ada arus mengalir\n• Reader hanya membaca beda\n  tegangan secara pasif\n• Voltage buffer impedansi\n  tinggi (>10¹³ Ω) mencegah\n  loading effect\n• Elektroda tidak aus karena\n  tidak ada reaksi Faradaic","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Diagram Pengukuran OCP:\n\n[WE-2 IrOx] ──────┐\n                       ├─ V_OCP ──► ADS1115\n[RE Ag/AgCl]  ──────┘\n\nKarateristik OCP:\n• TIDAK ada arus mengalir\n• Reader hanya membaca beda\n  tegangan secara pasif\n• Voltage buffer impedansi\n  tinggi (>10¹³ Ω) mencegah\n  loading effect\n• Elektroda tidak aus karena\n  tidak ada reaksi Faradaic","lineHeight":1.5},

