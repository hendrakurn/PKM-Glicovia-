    {"id":"p_normal_t","type":"text","x":666,"y":116,"width":284,"height":84,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":740,"version":1,"versionNonce":740,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"• pH saliva: 6,8 – 7,4 (fisiologis)\n• Kapasitas buffer bikarbonat terjaga\n• Aktivitas bakteri oral terkendali\n• Laju sekresi saliva normal\n  (~0,3–0,5 mL/menit saat istirahat)\n• OCP relatif stabil & dalam rentang\n  normal Nernstian","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"• pH saliva: 6,8 – 7,4 (fisiologis)\n• Kapasitas buffer bikarbonat terjaga\n• Aktivitas bakteri oral terkendali\n• Laju sekresi saliva normal\n  (~0,3–0,5 mL/menit saat istirahat)\n• OCP relatif stabil & dalam rentang\n  normal Nernstian","lineHeight":1.5},

