    {"id":"v_s2_ht","type":"text","x":474,"y":68,"width":496,"height":18,"angle":0,"strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":821,"version":1,"versionNonce":821,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"2. MEKANISME ALIRAN & DETEKSI WAKTU","fontSize":12,"fontFamily":2,"textAlign":"center","verticalAlign":"top","baseline":10,"containerId":null,"originalText":"2. MEKANISME ALIRAN & DETEKSI WAKTU","lineHeight":1.25},

    {"id":"v_flow_seq","type":"text","x":482,"y":96,"width":474,"height":216,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":822,"version":1,"versionNonce":822,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"LANGKAH 1 — Saliva masuk ke inlet:\nTetesan saliva ditempatkan di inlet saluran kapiler.\nGaya kapiler (akibat tegangan permukaan saliva\ndan sifat permukaan PDMS) menarik cairan\nmasuk ke dalam saluran tanpa pompa eksternal.\n\nLANGKAH 2 — Elektroda A tersentuh (t₁ = 0):\nSaat meniskus saliva mencapai Elektroda A,\nresistansi antara A dan saluran turun drastis.\nESP32-S3 mendeteksi perubahan ini via GPIO\n→ timer internal dimulai (t₁ = 0 µs).\n\nLANGKAH 3 — Elektroda B tersentuh (t₂):\nSaliva terus mengalir hingga mencapai Elektroda B.\nESP32-S3 mendeteksi perubahan resistansi B\n→ timer dicatat (t₂).\n\nHASIL: Δt = t₂ − t₁  (waktu tempuh, satuan µs → ms)\nSemakin tinggi viskositas → Δt semakin besar","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"LANGKAH 1 — Saliva masuk ke inlet:\nTetesan saliva ditempatkan di inlet saluran kapiler.\nGaya kapiler (akibat tegangan permukaan saliva\ndan sifat permukaan PDMS) menarik cairan\nmasuk ke dalam saluran tanpa pompa eksternal.\n\nLANGKAH 2 — Elektroda A tersentuh (t₁ = 0):\nSaat meniskus saliva mencapai Elektroda A,\nresistansi antara A dan saluran turun drastis.\nESP32-S3 mendeteksi perubahan ini via GPIO\n→ timer internal dimulai (t₁ = 0 µs).\n\nLANGKAH 3 — Elektroda B tersentuh (t₂):\nSaliva terus mengalir hingga mencapai Elektroda B.\nESP32-S3 mendeteksi perubahan resistansi B\n→ timer dicatat (t₂).\n\nHASIL: Δt = t₂ − t₁  (waktu tempuh, satuan µs → ms)\nSemakin tinggi viskositas → Δt semakin besar","lineHeight":1.5},

