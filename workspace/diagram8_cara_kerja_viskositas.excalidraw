    {"id":"v_hp_eq_box","type":"rectangle","x":20,"y":368,"width":430,"height":50,"angle":0,"strokeColor":"#7c3aed","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":826,"version":1,"versionNonce":826,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"v_hp_eq_t","type":"text","x":20,"y":381,"width":430,"height":26,"angle":0,"strokeColor":"#3b0764","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":827,"version":1,"versionNonce":827,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Q  =  (π × r⁴ × ΔP) / (8 × η × L)          η  =  k × Δt","fontSize":14,"fontFamily":2,"textAlign":"center","verticalAlign":"top","baseline":11,"containerId":null,"originalText":"Q  =  (π × r⁴ × ΔP) / (8 × η × L)          η  =  k × Δt","lineHeight":1.25},

    {"id":"v_hp_explain","type":"text","x":18,"y":428,"width":434,"height":126,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":828,"version":1,"versionNonce":828,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Notasi:\n  Q = laju alir volumetrik (m³/s)\n  r = jari-jari saluran (m)  →  0,1 mm = 0,0001 m\n  ΔP = beda tekanan (Pa)  →  dari gaya kapiler\n  η = viskositas dinamik (cP = mPa·s)\n  L = panjang saluran (m)  →  20 mm\n\nKarena r, ΔP, L TETAP untuk saluran yang sama:\n  Q ∝ 1/η   →   waktu alir Δt ∝ η\n\nKonstanta kalibrasi k diperoleh dari larutan\ngliserol-aquades dengan viskositas yang diketahui.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Notasi:\n  Q = laju alir volumetrik (m³/s)\n  r = jari-jari saluran (m)  →  0,1 mm = 0,0001 m\n  ΔP = beda tekanan (Pa)  →  dari gaya kapiler\n  η = viskositas dinamik (cP = mPa·s)\n  L = panjang saluran (m)  →  20 mm\n\nKarena r, ΔP, L TETAP untuk saluran yang sama:\n  Q ∝ 1/η   →   waktu alir Δt ∝ η\n\nKonstanta kalibrasi k diperoleh dari larutan\ngliserol-aquades dengan viskositas yang diketahui.","lineHeight":1.5},

