    {"id":"v_cross_section","type":"rectangle","x":30,"y":200,"width":420,"height":110,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":817,"version":1,"versionNonce":817,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
    {"id":"v_cross_t","type":"text","x":38,"y":206,"width":404,"height":96,"angle":0,"strokeColor":"#713f12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":818,"version":1,"versionNonce":818,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false,"text":"Tampak Melintang (Cross-Section):\n\n         ┌─────────── 0,5 mm ───────────┐\n  0,2 mm │         Saluran Kapiler       │\n         └──────────────────────────────┘\n                  Material: PDMS\n                 (Polydimethylsiloxane)\n\nPDMS dipilih: hidrofobik alami → gaya kapiler terbentuk\notomatis, biokompatibel, transparan, mudah difabrikasi\ndengan soft lithography atau laser cutting.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":9,"containerId":null,"originalText":"Tampak Melintang (Cross-Section):\n\n         ┌─────────── 0,5 mm ───────────┐\n  0,2 mm │         Saluran Kapiler       │\n         └──────────────────────────────┘\n                  Material: PDMS\n                 (Polydimethylsiloxane)\n\nPDMS dipilih: hidrofobik alami → gaya kapiler terbentuk\notomatis, biokompatibel, transparan, mudah difabrikasi\ndengan soft lithography atau laser cutting.","lineHeight":1.4},

    {"id":"v_s2","type":"rectangle","x":474,"y":62,"width":496,"height":260,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fffbeb","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":819,"version":1,"versionNonce":819,"isDeleted":false,"boundElements":null,"updated":1749000000000,"link":null,"locked":false},
