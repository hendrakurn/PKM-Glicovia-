    {
      "type": "text",
      "id": "calc_text",
      "x": 1240,
      "y": 187,
      "text": "Semua kombinasi dicoba\n\n4 nilai C x 4 nilai gamma x 3 nilai epsilon\n= 48 kombinasi\n\nContoh 1 kombinasi:\nC=100, gamma=0.1, epsilon=0.1",
      "fontSize": 24,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "Semua kombinasi dicoba\n\n4 nilai C x 4 nilai gamma x 3 nilai epsilon\n= 48 kombinasi\n\nContoh 1 kombinasi:\nC=100, gamma=0.1, epsilon=0.1",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "a_footer",
      "x": 80,
      "y": 338,
      "text": "Intinya: setiap kombinasi adalah satu set nilai (C, gamma, epsilon). GridSearchCV mencoba semua kemungkinan agar bisa membandingkan performanya secara adil.",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#7c2d12",
      "originalText": "Intinya: setiap kombinasi adalah satu set nilai (C, gamma, epsilon). GridSearchCV mencoba semua kemungkinan agar bisa membandingkan performanya secara adil.",
      "autoResize": true
    },
