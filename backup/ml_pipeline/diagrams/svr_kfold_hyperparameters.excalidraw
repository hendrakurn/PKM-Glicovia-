      "x": 115,
      "y": 518,
      "text": "Ambil 1 kombinasi dulu\nmisal: C=100, gamma=0.1, epsilon=0.1",
      "fontSize": 22,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
