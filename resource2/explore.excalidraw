    {
      "id": "yY1ufc4dudsMMtlfcvDpi",
      "type": "text",
      "x": 2918.2033006076394,
      "y": 365.8352323717882,
      "width": 378.44205066599073,
      "height": 201.65160363954251,
      "angle": 0,
      "strokeColor": "#581c87",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1784303521,
      "version": 214,
      "versionNonce": 193913857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783513800976,
      "link": null,
      "locked": false,
      "text": "Diagram Pengukuran OCP:\n\n[WE-2 IrOx] ──────┐\n                       ├─ V_OCP ──► ADS1115\n[RE Ag/AgCl]  ──────┘\n\nKarateristik OCP:\n• TIDAK ada arus mengalir\n• Reader hanya membaca beda\n  tegangan secara pasif\n• Voltage buffer impedansi\n  tinggi (>10¹³ Ω) mencegah\n  loading effect\n• Elektroda tidak aus karena\n  tidak ada reaksi Faradaic",
      "fontSize": 15.192929041335393,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Diagram Pengukuran OCP:\n\n[WE-2 IrOx] ──────┐\n                       ├─ V_OCP ──► ADS1115\n[RE Ag/AgCl]  ──────┘\n\nKarateristik OCP:\n• TIDAK ada arus mengalir\n• Reader hanya membaca beda\n  tegangan secara pasif\n• Voltage buffer impedansi\n  tinggi (>10¹³ Ω) mencegah\n  loading effect\n• Elektroda tidak aus karena\n  tidak ada reaksi Faradaic",
      "lineHeight": 1.5,
      "index": "bAX",
      "autoResize": true,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
