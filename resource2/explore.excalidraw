    },
    {
      "id": "wBnAXHuUMs5p4k7ZM7VKE",
      "type": "text",
      "x": 3355.5479541892964,
      "y": 1429.5056040747113,
      "width": 424.59361957161354,
      "height": 261.504679603709,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1335403727,
      "version": 84,
      "versionNonce": 341404271,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783513808569,
      "link": null,
      "locked": false,
      "text": "Nafion adalah polimer kation-selektif:\n\n  Saliva → [Nafion] → [GOx] → WE\n\n  ✓  Glukosa          → LOLOS (netral, kecil)\n  ✓  H₂O₂             → LOLOS (netral, kecil)\n  ✗  Asam askorbat  → DIBLOKIR (anionik)\n  ✗  Asam urat        → DIBLOKIR (anionik)\n  ✗  Protein besar   → DIBLOKIR (sterik)\n\nTanpa Nafion → sinyal palsu dari interferensi\nDengan Nafion → selektivitas tinggi terhadap\nglukosa (via H₂O₂)",
      "fontSize": 15.465330514197845,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Nafion adalah polimer kation-selektif:\n\n  Saliva → [Nafion] → [GOx] → WE\n\n  ✓  Glukosa          → LOLOS (netral, kecil)\n  ✓  H₂O₂             → LOLOS (netral, kecil)\n  ✗  Asam askorbat  → DIBLOKIR (anionik)\n  ✗  Asam urat        → DIBLOKIR (anionik)\n  ✗  Protein besar   → DIBLOKIR (sterik)\n\nTanpa Nafion → sinyal palsu dari interferensi\nDengan Nafion → selektivitas tinggi terhadap\nglukosa (via H₂O₂)",
      "lineHeight": 1.5,
      "index": "bCi",
      "autoResize": true,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
