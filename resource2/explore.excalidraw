    {
      "id": "XGRSsRaIkUPAUM2hLAxYa",
      "type": "text",
      "x": 3365.7041196433365,
      "y": 448.7057544154358,
      "width": 392.253804339932,
      "height": 19.336455143517775,
      "angle": 0,
      "strokeColor": "#7f1d1d",
      "backgroundColor": "transparent",
