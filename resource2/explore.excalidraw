      "updated": 1783513800976,
      "link": null,
      "locked": false,
      "text": "Kondisi NORMAL (non-diabetes):",
      "fontSize": 15.192929041335393,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Kondisi NORMAL (non-diabetes):",
      "lineHeight": 1.25,
      "index": "bAl",
      "autoResize": true,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "MqnnfftkrNW5iKA12D1S8",
      "type": "text",
      "x": 3365.7041196433365,
      "y": 302.30116547165835,
      "width": 392.253804339932,
      "height": 116.01873086110665,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1037290945,
      "version": 214,
      "versionNonce": 278834721,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783513800976,
      "link": null,
      "locked": false,
      "text": "• pH saliva: 6,8 – 7,4 (fisiologis)\n• Kapasitas buffer bikarbonat terjaga\n• Aktivitas bakteri oral terkendali\n• Laju sekresi saliva normal\n  (~0,3–0,5 mL/menit saat istirahat)\n• OCP relatif stabil & dalam rentang\n  normal Nernstian",
      "fontSize": 15.192929041335393,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "• pH saliva: 6,8 – 7,4 (fisiologis)\n• Kapasitas buffer bikarbonat terjaga\n• Aktivitas bakteri oral terkendali\n• Laju sekresi saliva normal\n  (~0,3–0,5 mL/menit saat istirahat)\n• OCP relatif stabil & dalam rentang\n  normal Nernstian",
      "lineHeight": 1.5,
      "index": "bAm",
      "autoResize": true,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
